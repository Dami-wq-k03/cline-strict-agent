# Required for the sample model provider.
ANTHROPIC_API_KEY=replace_me
CLINE_MODEL=claude-sonnet-4-6

# The mock HTTP API starts locally when true. Set false when using your own API.
START_MOCK_API=true
MOCK_API_PORT=8787
INTERNAL_API_BASE_URL=http://127.0.0.1:8787

# Optional: use a remote MCP server over Streamable HTTP instead of the demo stdio server.
# The remote server must expose a tool named lookup_ticket with { ticketId: string } arguments.
# MCP_SERVER_URL=http://127.0.0.1:3000/mcp

# Optional: use a trusted local MCP server command instead of the demo server.
# Do not populate these values from user/model input.
# MCP_SERVER_COMMAND=/absolute/path/to/your-mcp-server
# MCP_SERVER_ARGS_JSON=["--some-arg"]
